APP_NAME="Srolanh Management Platform"
APP_ENV=local
APP_KEY=
# SECURITY: APP_DEBUG MUST be false in production. With APP_ENV=production and
# APP_DEBUG=true, any unhandled error renders Laravel's debug page, which leaks
# every value in this file (DB password, API keys) to the browser.
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend base URLs (used for CORS, password-reset links, public invite URLs).
RSVP_APP_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000
CLIENT_APP_URL=http://localhost:3001

# Telegram admin notifications. Wedding-day alerts are posted in forum topic 85.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_TOPIC_ID=
TELEGRAM_WEDDING_ALERT_TOPIC_ID=85
TELEGRAM_WEDDING_ALERT_TIMEZONE=Asia/Phnom_Penh
TELEGRAM_WEDDING_ALERT_SEND_AT=08:00

# Shared secret used by the backend and RSVP app to invalidate invitation caches.
RSVP_REVALIDATE_SECRET=replace-with-a-long-random-secret

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — PostgreSQL. For local dev use the discrete DB_* vars; for a hosted
# provider (e.g. Neon) you can instead set a single DB_URL connection string,
# which takes precedence over the discrete vars.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=srolanh_db
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# DB_URL=postgresql://user:password@host/dbname?sslmode=require

# CORS — list ONLY your own front-end origins. Never use a wildcard in production.
# Local origins (localhost:3000-3003) are auto-allowed when APP_ENV != production.
CORS_ALLOWED_ORIGINS="https://your-marketing.example.com, https://your-admin.example.com, https://your-client.example.com, https://your-rsvp.example.com"
# Optional regex for preview deploys. Scope it to your own projects.
# CORS_ALLOWED_ORIGIN_PATTERNS="#^https://sls-(admin|client|rsvp)-[a-z0-9-]+\.vercel\.app$#"

# API bearer-token lifetime in minutes (default 360 = 6 hours). Clients renew
# via POST /api/auth/refresh. Set to 0 to issue non-expiring tokens.
SANCTUM_EXPIRATION=360

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Media storage: "public" (local disk), "cloudinary", or "s3" (S3/R2).
MEDIA_DISK=public

# "database" runs queued jobs out of the request cycle and requires a worker.
# Use "sync" for local development with no queue worker.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email via Brevo's HTTP API. Use MAIL_MAILER=log for local development.
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Platform payment details shown to couples when paying for a package.
PLATFORM_BANK_NAME=
PLATFORM_ACCOUNT_NAME=
PLATFORM_ACCOUNT_NUMBER=
PLATFORM_KHQR_IMAGE_URL=/khqr.png
PLATFORM_PAYMENT_INSTRUCTIONS=

# Cloudinary — set MEDIA_DISK=cloudinary to use.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible object storage — set MEDIA_DISK=s3 to use.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
